# Copier en .env (jamais commité). Un seul adaptateur LLM compatible OpenAI ;
# le profil choisit le serveur et le paramètre « sans réflexion » adapté.
#   local : vLLM maison  (chat_template_kwargs.enable_thinking=false)
#   ci    : OpenRouter   (reasoning.enabled=false)
LLM_PROFILE=local

# vLLM local (OpenAI-compatible)
VLLM_BASE_URL=http://192.168.1.87:30000/v1
VLLM_API_KEY=
VLLM_CHAT_MODEL=qwen3.8-flash-next-a5b

# OpenRouter (CI, et embeddings partout)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=mistralai/mistral-small-2603

# Embeddings : même modèle partout, sinon l'index Faiss est incompatible.
EMBEDDING_MODEL=mistralai/mistral-embed-2312
