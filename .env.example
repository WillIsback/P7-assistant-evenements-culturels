# Copier en .env (jamais commité). Un seul adaptateur LLM compatible OpenAI ;
# le profil choisit le serveur et le paramètre « sans réflexion » adapté.
#   local : vLLM maison  (chat_template_kwargs.enable_thinking=false)
#   ci    : OpenRouter   (reasoning.enabled=false)
LLM_PROFILE=local

# vLLM local (OpenAI-compatible)
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_CHAT_MODEL=

# OpenRouter (CI, et embeddings partout)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=mistralai/mistral-small-2603

# Embeddings : même modèle partout, sinon l'index Faiss est incompatible.
EMBEDDING_MODEL=mistralai/mistral-embed-2312

# Open Agenda (API v2)
OPENAGENDA_API_KEY=
# Agenda interrogé (21769447 par défaut dans le code si absent).
OPENAGENDA_AGENDA_UID=21769447

# Base de données (SQLite par défaut). Chemin relatif au dossier de travail :
# ./data/database.db en local, /app/data/database.db dans l'image (volume /app/data).
DATABASE_URL=sqlite:///./data/database.db

# Authentification JWT — générer la clé avec : openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cache. Absent : mémoire du processus (dev). L'image Docker fixe un cache disque
# (disk://?directory=/app/cache&shards=4). Valkey optionnel : redis://hote:6379/0
CACHE_URL=
CACHE_ENABLED=true

# Index régional (scripts/build_index.py). Valide INDEX_TTL_HOURS heures, puis
# resynchronisé en tâche de fond par l'API.
INDEX_DIR=./data/index
INDEX_TTL_HOURS=24
# Seuil de pertinence du retrieval (distance L2² mistral-embed ; plus bas = plus strict).
RAG_MAX_DISTANCE=0.53

# Jeton de POST /rebuild (absent : route désactivée). Générer : openssl rand -hex 32
REBUILD_TOKEN=
